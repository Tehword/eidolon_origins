{
  "hidden": true,
  "type": "origins:multiple",
  "ambient_sound": {
    "type": "origins:action_over_time",
    "interval": 6000,
    "entity_action": {
      "type": "origins:play_sound",
      "sound": "eidolon_origins:lych_sounds"
    }
  },
  "sound_on_hit": {
  "type": "origins:self_action_when_hit",
    "entity_action": {
      "type": "origins:play_sound",
      "sound": "eidolon_origins:lych_sound_hurt"
    },
    "condition": {
      "type": "origins:health",
      "comparison": ">=",
      "compare_to": 0
    }
  },
  "sound_on_death": {
      "type": "origins:action_over_time",
      "rising_action": {
       "type": "origins:play_sound",
       "sound": "eidolon_origins:lych_sound_death"
    },
      "condition": {
        "type": "origins:health",
        "comparison": "<=",
        "compare_to": 0
      }
  }
}